{
  "name": "sotto",
  "version": "1.0.1",
  "private": true,
  "description": "Per-tab volume control for Chromium browsers: volume, boost, mono, and a clean release.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "store-assets": "node scripts/store-assets.mjs",
    "pack": "node scripts/pack.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "format": "prettier --write .",
    "check": "eslint . && tsc -p jsconfig.json && prettier --check . && npm test",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  }
}
