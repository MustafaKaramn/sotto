{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Sotto",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": ["activeTab", "tabCapture", "offscreen"],
  "commands": {
    "volume-up": {
      "suggested_key": {
        "default": "Alt+Shift+Up"
      },
      "description": "__MSG_commandVolumeUp__"
    },
    "volume-down": {
      "suggested_key": {
        "default": "Alt+Shift+Down"
      },
      "description": "__MSG_commandVolumeDown__"
    },
    "toggle-mono": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "__MSG_commandMono__"
    },
    "toggle-night": {
      "description": "__MSG_commandNight__"
    },
    "release": {
      "suggested_key": {
        "default": "Alt+Shift+0"
      },
      "description": "__MSG_commandRelease__"
    },
    "reset": {
      "description": "__MSG_commandReset__"
    }
  }
}
